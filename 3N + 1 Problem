#include <stdio.h>

int main() {
    int i, j;

    while (scanf("%d %d", &i, &j) != EOF) {

        int max = 0;
        for (int x = i; x <= j; x++) {
            int n = x;
            int count = 1;
            while (n != 1) {
                if (n % 2)
                    n = 3*n + 1;
                else
                    n = n / 2;
                count++;
            }
            if (count > max)
                max = count;
        }
        printf("%d %d %d\n", i, j, max);
    }
    return 0;
}
